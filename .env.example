# Required. From the Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. The shared demo account the agent bridge logs in with.
COURSE_CONTEXT_DEMO_EMAIL=
COURSE_CONTEXT_DEMO_PASSWORD=

# Scripts only. Read by scripts/admin-create-users.mjs to create pre-confirmed
# accounts. The app never reads it. Keep it out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=

# Tests only. Playwright sets this to run the app against a fixture workspace
# with no Supabase project. Leave it unset for normal development.
# COURSE_CONTEXT_E2E_FIXTURE=true
